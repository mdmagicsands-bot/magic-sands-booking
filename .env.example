SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.up.railway.app

# Local dev server port for this project (guest booking + partner portal).
# voucher-system uses port 8000 — keep them different.
# DEV_SERVER_PORT=8001

# LiteAPI / Nuitee Connect — free sandbox at https://liteapi.travel/
LITEAPI_API_KEY=sand_your_key_here
LITEAPI_PUBLIC_KEY=sandbox

DEFAULT_CURRENCY=USD
DEFAULT_GUEST_NATIONALITY=OM

# Hostinger marketing site (login + register pages only)
MARKETING_SITE_URL=https://www.magicsandsdmc.com

# This booking app public URL (Railway in production)
PUBLIC_BOOKING_URL=http://127.0.0.1:8001

CSRF_TRUSTED_ORIGINS=https://www.magicsandsdmc.com,https://magicsandsdmc.com,http://127.0.0.1:8001,http://localhost:8001
